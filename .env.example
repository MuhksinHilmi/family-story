# =============================================================================
# CERITA KELUARGA — Environment Variables
# Salin file ini ke .env.local untuk development lokal.
# Set semua nilai ini di Vercel Dashboard → Settings → Environment Variables
# untuk production.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Primary — Neon Postgres untuk production, local Postgres untuk dev)
# Cara dapat: https://console.neon.tech → project → Connection Details
#
# PRODUCTION: Set DATABASE_URL saja (Neon connection string with SSL)
# LOKAL DEV: Boleh set DATABASE_URL atau DB_* vars individual
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Alternatif untuk local dev (tidak perlu jika sudah set DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=family_story
# DB_USER=postgres
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# SUPABASE (Realtime chat + Storage)
# Cara dapat: https://supabase.com → project → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT Secret Supabase untuk mint realtime token
# Cara dapat: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# -----------------------------------------------------------------------------
# CUSTOM AUTH JWT
# Buat dengan: openssl rand -base64 32
# -----------------------------------------------------------------------------
JWT_SECRET=ganti-dengan-secret-random-minimal-32-karakter
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# EMAIL (Gmail SMTP dengan App Password)
# Cara dapat App Password:
#   1. Aktifkan 2-Step Verification di akun Gmail
#   2. Buka https://myaccount.google.com/apppasswords
#   3. Buat app password baru → copy 16 karakter
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=emailkamu@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# -----------------------------------------------------------------------------
# APP URL
# LOKAL: http://localhost:3000
# PRODUCTION: https://subdomain.domainmu.com
# Dipakai di: email activation link, invitation link, notifikasi
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
